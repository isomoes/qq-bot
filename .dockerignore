# Keep the repo-root build context (docker/docker-compose.yml uses `context: ..`)
# lean and secret-free. The Dockerfile only copies config/ + dist/ + node_modules
# into the image, but node_modules/.env/data must not even reach the daemon.

# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/

# Secrets — never send the local .env (BOT_SECRET, NEWS_LLM_API_KEY) to the daemon
.env
.env.local
.env.*.local

# Runtime data (news SQLite db) and logs
data/
logs/
*.log

# VCS / editor noise
.git
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test + dev-only
test/
scripts/